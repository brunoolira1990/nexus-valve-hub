# Nexus ERP — exemplo de configuração
# Copie este arquivo para .env e ajuste os valores reais no servidor.

DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao

# Em produção/rede local, preencher com o IP ou hostname do servidor.
ALLOWED_HOSTS=localhost,127.0.0.1

# URLs confiáveis para frontend/backend em rede.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Ambiente visual do app: desenvolvimento | homologacao | producao
NEXUS_APP_AMBIENTE=homologacao

# Banco de dados
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# Fiscal
# Manter homologacao até decisão explícita de uso fiscal em produção.
NFE_AMBIENTE=homologacao
