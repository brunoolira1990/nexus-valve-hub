# Nexus ERP — exemplo de configuração
# Copie este arquivo para .env e ajuste os valores reais no servidor.

DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao

# Em produção/rede local, preencher com o IP ou hostname do servidor.
ALLOWED_HOSTS=localhost,127.0.0.1

# URLs confiáveis para frontend/backend em rede.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Ambiente visual do app: desenvolvimento | homologacao | producao
NEXUS_APP_AMBIENTE=homologacao

# Banco de dados
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# --- Produtos / Família-Figura (ERP 4.0.14.x) ---
# Decisão de produção (operador): PREFIXO_GLOBAL_UNICIDADE
# — 6119 e 6119OD não são famílias distintas; OD vem do template dimensional.
# Em produção defina explicitamente (valor real só no .env do servidor):
# FAMILIA_CODIGO_POLITICA_PREFIXO=PREFIXO_GLOBAL_UNICIDADE
# Alternativas (não usar em produção neste ERP):
# FAMILIA_CODIGO_POLITICA_PREFIXO=VALOR_COMPLETO
# FAMILIA_CODIGO_POLITICA_PREFIXO=PREFIXO_GLOBAL_SEQUENCIAL

# Fiscal
# Manter homologacao até decisão explícita de uso fiscal em produção.
# Nota: consulta status SEFAZ (/nfe-sefaz) usa o ambiente escolhido na tela (homologacao/producao),
# não esta variável. NFE_AMBIENTE é referência documental para emissão.
NFE_AMBIENTE=homologacao
# Emissão NF-e Saída produção SEFAZ — default false (Fase 3B). Não alterar sem go-live formal.
NFE_PRODUCAO_HABILITADA=false
# E-mail operacional (envio manual DANFE/XML NF-e Saída) — placeholders; valores reais só no .env
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=25
EMAIL_HOST_USER=seu-usuario-smtp@example.com
EMAIL_HOST_PASSWORD=coloque-sua-senha-smtp-aqui
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=seu-usuario-smtp@example.com
NEXUS_EMAIL_OPERACIONAL=operacional@example.com
# Dev/WSL: evita proxy local interceptar HTTPS da SEFAZ (resposta HTML em vez de XML).
# NO_PROXY=.fazenda.gov.br,.fazenda.sp.gov.br,.sefaz.rs.gov.br,localhost,127.0.0.1,backend,db

# Integração servidor a servidor do site com o CRM.
# O mesmo segredo forte deve ser configurado nos ambientes reais; nunca versioná-lo.
CRM_SITE_HMAC_SECRET=
