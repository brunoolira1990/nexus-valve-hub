# Nexus ERP — exemplo de configuração para .env de PRODUÇÃO (VPS).
# Copie este arquivo para .env e ajuste os valores reais no servidor.
# NUNCA commite o .env real.

DEBUG=false
SECRET_KEY=troque-por-openssl-rand-hex-50

# Em produção, preencher com hostname público + hosts internos.
ALLOWED_HOSTS=erp.nexusvalvulas.com.br,127.0.0.1,localhost,backend
CORS_ALLOWED_ORIGINS=https://erp.nexusvalvulas.com.br
CSRF_TRUSTED_ORIGINS=https://erp.nexusvalvulas.com.br

# Ambiente visual do app: desenvolvimento | homologacao | producao
NEXUS_APP_AMBIENTE=producao

# Banco de dados (Docker Compose da VPS usa estes nomes)
POSTGRES_DB=nexus_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-openssl-rand-base64-32
POSTGRES_HOST=db
POSTGRES_PORT=5432

DB_NAME=nexus_erp
DB_USER=postgres
DB_PASSWORD=troque-por-openssl-rand-base64-32
DB_HOST=db
DB_PORT=5432

DATABASE_NAME=nexus_erp
DATABASE_USER=postgres
DATABASE_PASSWORD=troque-por-openssl-rand-base64-32
DATABASE_HOST=db
DATABASE_PORT=5432

# Django superuser (criado no primeiro boot se não existir)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@nexusvalvulas.com.br
DJANGO_SUPERUSER_PASSWORD=troque-por-senha-forte

# --- Produtos / Família-Figura (ERP 4.0.14.x) ---
# Decisão de produção: PREFIXO_GLOBAL_UNICIDADE
# — 6119 e 6119OD não são famílias distintas; OD vem do template dimensional.
FAMILIA_CODIGO_POLITICA_PREFIXO=PREFIXO_GLOBAL_UNICIDADE

# --- Fiscal ---
# NFE_AMBIENTE é referência documental. A consulta SEFAZ (/nfe-sefaz) usa o
# ambiente escolhido na tela, não esta variável.
NFE_AMBIENTE=homologacao
# Emissão NF-e Saída produção SEFAZ — default false. Não alterar sem go-live formal.
NFE_PRODUCAO_HABILITADA=false

# Reforma Tributária (NT 2025.002) — habilitação em PRODUÇÃO
REFORMA_TRIBUTARIA_NFE_ENABLED=True
REFORMA_TRIBUTARIA_NFE_MODO=producao
REFORMA_TRIBUTARIA_NFE_INCLUIR_XML=True
REFORMA_TRIBUTARIA_NFE_PRODUCAO_BLOQUEADA=False
REFORMA_TRIBUTARIA_NFE_AMBIENTE_HOMOLOGACAO=False

# E-mail operacional (envio manual DANFE/XML NF-e Saída)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.nexusvalvulas.com.br
EMAIL_PORT=25
EMAIL_HOST_USER=nfe@nexusvalvulas.com.br
EMAIL_HOST_PASSWORD=troque-por-senha-real
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=nfe@nexusvalvulas.com.br
NEXUS_EMAIL_OPERACIONAL=nfe@nexusvalvulas.com.br

# Integração servidor a servidor do site com o CRM.
# O mesmo segredo forte deve ser configurado nos ambientes reais; nunca versioná-lo.
CRM_SITE_HMAC_SECRET=troque-por-openssl-rand-hex-32
