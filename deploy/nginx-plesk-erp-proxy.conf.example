# Exemplo de proxy no Plesk/Nginx do host (NÃO versionar com secrets).
# Objetivo: erp.nexusvalvulas.com.br -> stack Docker em 127.0.0.1:18080 (ERP_HTTP_PORT).
# SSL: configurar no Plesk (Let's Encrypt) para o subdomínio — não no Caddy interno.
#
# No Plesk: Domínios > erp.nexusvalvulas.com.br > Configurações do Apache e nginx >
# "Directivas nginx adicionais" (ou arquivo include equivalente).

location / {
    proxy_pass http://127.0.0.1:18080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_connect_timeout 60s;
    client_max_body_size 50m;
}
